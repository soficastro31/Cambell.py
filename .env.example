# Copia este archivo como .env y ajusta los valores. NO subas .env a Git.

# Seguridad
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos: sqlite (por defecto) o mysql
DB_ENGINE=sqlite
# Solo si DB_ENGINE=mysql:
DB_NAME=cambell
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Correo (recuperacion de contrasena). Si se deja vacio, los correos salen en la consola.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Fases siguientes (verificacion facial Face++)
FACEPP_API_KEY=
FACEPP_API_SECRET=
